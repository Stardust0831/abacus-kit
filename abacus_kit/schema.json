{
  "calculation": {"group":"Task","type":"choice","default":"scf"},
  "esolver_type": {"group":"Physics","parent":"calculation","type":"choice","choices":["ksdft","sdft","ofdft","tdofdft","tddft","lj","dp","nep","snap","lr","ks-lr","dfpt"],"default":"ksdft","requires":"esolver_type != 'tddft' or calculation == 'md'"},
  "basis_type": {"group":"Electronic","parent":"esolver_type","when":"esolver_type not in ('dp','lj','nep','snap')","type":"choice","cases":[{"when":"calculation in ('get_wf','get_pchg','get_s','test_neighbour') or esolver_type in ('lr','ks-lr')","value":"lcao"},{"value":"pw"}]},
  "ecutwfc": {"group":"Electronic","parent":"basis_type","when":"basis_type != None","type":"real","positive":true,"unit":"Ry","cases":[{"when":"given('ecutrho')","expr":"ecutrho / 4.0"},{"when":"basis_type == 'lcao'","value":100.0},{"value":50.0}]},
  "ecutrho": {"group":"Electronic","parent":"basis_type","when":"basis_type != None","type":"real","positive":true,"unit":"Ry","cases":[{"expr":"4.0 * ecutwfc"}],
    "requires":"ecutrho / ecutwfc >= 4.0 - 1e-8 and (basis_type != 'lcao' or ecutrho / ecutwfc <= 4.0 + 1e-8)",
    "error":"ecutrho / ecutwfc must be >= 4 (4 for LCAO with an automatic grid). Restore an automatic cutoff or edit its partner first."},
  "scf_thr": {"group":"Electronic","parent":"basis_type","when":"basis_type != None","type":"real","min":0,"cases":[{"when":"basis_type == 'lcao' or basis_type == 'lcao_in_pw'","value":1e-7},{"when":"calculation == 'nscf'","value":1e-6},{"value":1e-9}]},
  "scf_nmax": {"group":"Electronic","parent":"basis_type","when":"basis_type != None","type":"integer","min":1,"cases":[{"when":"calculation == 'nscf'","value":1},{"value":100}],"requires":"calculation != 'nscf' or scf_nmax == 1"},
  "nspin": {"group":"Spin","parent":"basis_type","when":"basis_type != None","type":"choice","default":1},
  "sc_mag_switch": {"group":"Spin","parent":"nspin","when":"nspin in (2,4) and esolver_type == 'ksdft'","type":"bool","default":false},
  "sc_scf_thr": {"group":"Spin","parent":"sc_mag_switch","when":"sc_mag_switch == True","type":"real","positive":true,"default":0.0001},
  "mixing_restart": {"group":"Electronic","parent":"basis_type","when":"esolver_type == 'ksdft'","type":"real","cases":[{"when":"not sc_mag_switch","value":0.0},{"when":"sc_scf_thr == 10","expr":"scf_thr / 10.0"},{"expr":"sc_scf_thr"}]},
  "relax_nmax": {"group":"Relaxation","parent":"calculation","when":"calculation in ('relax', 'cell-relax')","type":"integer","min":1,"default":50},
  "force_thr_ev": {"group":"Relaxation","parent":"calculation","when":"calculation in ('relax', 'cell-relax')","type":"real","positive":true,"unit":"eV/Angstrom","default":0.0257112},
  "md_type": {"group":"Dynamics","parent":"calculation","when":"calculation == 'md'","type":"choice","default":"nvt"},
  "md_nstep": {"group":"Dynamics","parent":"calculation","when":"calculation == 'md'","type":"integer","min":1,"default":10},
  "md_dt": {"group":"Dynamics","parent":"calculation","when":"calculation == 'md'","type":"real","positive":true,"unit":"fs","default":1.0},
  "md_tfirst": {"group":"Dynamics","parent":"calculation","when":"calculation == 'md'","type":"real","positive":true,"unit":"K","default":300.0},
  "md_tlast": {"group":"Thermostat","parent":"md_type","when":"md_type in ('nvt', 'npt')","type":"real","positive":true,"unit":"K","cases":[{"expr":"md_tfirst"}]},
  "md_thermostat": {"group":"Thermostat","parent":"md_type","when":"md_type == 'nvt'","type":"choice","default":"nhc"},
  "md_tfreq": {"group":"Thermostat","parent":"md_type","when":"md_type == 'npt' or md_thermostat == 'nhc'","type":"real","positive":true,"unit":"1/fs","cases":[{"expr":"1.0 / (40.0 * md_dt)"}]},
  "md_csvr_tau": {"group":"Thermostat","parent":"md_thermostat","when":"md_thermostat == 'csvr'","type":"real","positive":true,"unit":"fs","cases":[{"expr":"100.0 * md_dt"}]},
  "md_pmode": {"group":"Barostat","parent":"md_type","when":"md_type == 'npt'","type":"choice","choices":["iso","aniso","tri"],"default":"iso"},
  "md_pfirst": {"group":"Barostat","parent":"md_type","when":"md_type == 'npt'","type":"real","unit":"kbar","default":1.0},
  "md_plast": {"group":"Barostat","parent":"md_type","when":"md_type == 'npt'","type":"real","unit":"kbar","cases":[{"expr":"md_pfirst"}]},
  "md_pfreq": {"group":"Barostat","parent":"md_type","when":"md_type == 'npt'","type":"real","positive":true,"unit":"1/fs","cases":[{"expr":"1.0 / (400.0 * md_dt)"}]},
  "cal_force": {"group":"Observables","parent":"calculation","type":"bool","cases":[{"expr":"calculation in ('relax', 'cell-relax', 'md')"}],"requires":"(calculation not in ('relax','cell-relax','md') or cal_force) and (calculation not in ('get_s','get_pchg','get_wf') or not cal_force)"},
  "cal_stress": {"group":"Observables","parent":"calculation","type":"bool","cases":[{"expr":"calculation == 'cell-relax' or (calculation == 'md' and (md_type in ('npt', 'msst') or esolver_type in ('lj', 'dp')))"}],"requires":"(calculation != 'cell-relax' and md_type not in ('npt','msst')) or cal_stress","restore_on_conflict":["md_type"]},
  "pot_file": {"group":"Potential","parent":"esolver_type","when":"esolver_type in ('dp','nep','snap')","type":"file","default":"graph.pb"},
  "dp_rescaling": {"group":"DeePMD","parent":"esolver_type","when":"esolver_type == 'dp'","type":"real","default":1.0},
  "dp_fparam": {"group":"DeePMD","parent":"pot_file","when":"esolver_type == 'dp'","model_dimension":"dim_fparam","type":"vector","default":[]},
  "dp_aparam": {"group":"DeePMD","parent":"pot_file","when":"esolver_type == 'dp'","model_dimension":"dim_aparam","type":"vector","default":[]}
}
